generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum GroupRole {
  OWNER
  MEMBER
}

enum InviteStatus {
  PENDING
  ACCEPTED
  DECLINED
}

enum TrackingKind {
  SLEEP_TIME_GADGET_USAGE
  DAILY_STEPS
  WORK_ARRIVAL_TIME
}

enum PenaltyUnit {
  MONEY
  CHORE
  OTHER
}

enum SleepEventType {
  APP_START
  ACTIVITY
  APP_CLOSE
  PHONE_ACTIVITY
  PHONE_SESSION_START
  PHONE_SESSION_END
  SYSTEM_SHUTDOWN
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  username      String?   @unique
  displayName   String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts        Account[]
  sessions        Session[]
  ownedGroups     Group[]       @relation("GroupOwner")
  memberships     GroupMember[]
  sentInvites     GroupInvite[] @relation("InviteSender")
  receivedInvites GroupInvite[] @relation("InviteRecipient")
  sleepEvents     SleepEvent[]
  sleepNights     SleepNight[]
  stepEvents      StepEvent[]
  stepNights      StepNight[]
  workArrivalDays WorkArrivalDay[]
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
}

model Group {
  id             String         @id @default(cuid())
  name           String
  ownerId        String
  owner          User           @relation("GroupOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  trackingKinds  TrackingKind[] @default([])
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  members GroupMember[]
  invites GroupInvite[]
}

model GroupMember {
  id       String    @id @default(cuid())
  groupId  String
  userId   String
  role     GroupRole @default(MEMBER)
  joinedAt DateTime  @default(now())

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  sleepSchedules       SleepSchedule[]
  sleepOverrides       SleepOverride[]
  sleepPenalties       SleepPenalty[]
  stepTargets          StepTarget[]
  stepPenalties        StepPenalty[]
  workArrivalTargets   WorkArrivalTarget[]
  workArrivalOverrides WorkArrivalOverride[]
  workArrivalPenalties WorkArrivalPenalty[]

  @@unique([groupId, userId])
}

model SleepSchedule {
  id            String   @id @default(cuid())
  groupMemberId String
  groupMember   GroupMember @relation(fields: [groupMemberId], references: [id], onDelete: Cascade)
  /// Night-anchor calendar date this weekly schedule starts on.
  effectiveFrom DateTime @db.Date
  /// IANA timezone the weekly times are local to, e.g. Asia/Singapore.
  timezone      String
  /// JSON object keyed by JS weekday 0–6 (Sun=0). Values are half-hours past 8pm local.
  times         Json
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([groupMemberId, effectiveFrom])
}

model SleepOverride {
  id               String   @id @default(cuid())
  groupMemberId    String
  groupMember      GroupMember @relation(fields: [groupMemberId], references: [id], onDelete: Cascade)
  /// Night-anchor calendar date this one-off bedtime applies to.
  date             DateTime @db.Date
  timezone         String
  halfHoursPast8pm Int
  note             String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([groupMemberId, date])
}

model SleepPenalty {
  id            String      @id @default(cuid())
  groupMemberId String
  groupMember   GroupMember @relation(fields: [groupMemberId], references: [id], onDelete: Cascade)
  /// Night-anchor calendar date this penalty rate starts on.
  effectiveFrom DateTime    @db.Date
  /// Charge per half hour past bedtime.
  amount        Decimal     @db.Decimal(10, 2)
  unit          PenaltyUnit
  /// Required when unit is OTHER; ignored otherwise.
  unitLabel     String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@unique([groupMemberId, effectiveFrom])
}

model SleepEvent {
  id        String         @id @default(cuid())
  userId    String
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  eventType SleepEventType
  eventTime DateTime       @default(now())
  sessionId String?        @db.Uuid
  createdAt DateTime       @default(now())

  @@index([userId, eventTime(sort: Desc)])
  @@index([eventType, eventTime(sort: Desc)])
}

/// Cached per-night summary: one row per (user, night).
model SleepNight {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Night-anchor calendar date this summary covers.
  night        DateTime @db.Date
  lastActivity DateTime?
  updatedAt    DateTime @updatedAt

  @@unique([userId, night])
  @@index([night(sort: Desc)])
}

model StepEvent {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Calendar day these steps were counted for.
  day       DateTime @db.Date
  stepCount Int
  eventTime DateTime @default(now())
  sessionId String?  @db.Uuid
  createdAt DateTime @default(now())

  @@index([userId, day(sort: Desc)])
}

model StepTarget {
  id            String      @id @default(cuid())
  groupMemberId String
  groupMember   GroupMember @relation(fields: [groupMemberId], references: [id], onDelete: Cascade)
  /// Calendar date this daily step target starts on.
  effectiveFrom DateTime    @db.Date
  targetSteps   Int
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@unique([groupMemberId, effectiveFrom])
}

model StepPenalty {
  id            String      @id @default(cuid())
  groupMemberId String
  groupMember   GroupMember @relation(fields: [groupMemberId], references: [id], onDelete: Cascade)
  /// Calendar date this penalty rate starts on.
  effectiveFrom DateTime    @db.Date
  /// Charge per 500 steps below the covering target.
  amount        Decimal     @db.Decimal(10, 2)
  unit          PenaltyUnit
  /// Required when unit is OTHER; ignored otherwise.
  unitLabel     String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@unique([groupMemberId, effectiveFrom])
}

/// Cached per-day step total: one row per (user, night).
model StepNight {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Calendar day this step total covers (column name mirrors SleepNight).
  night     DateTime @db.Date
  steps     Int
  updatedAt DateTime @updatedAt

  @@unique([userId, night])
  @@index([night(sort: Desc)])
}

/// One check-in per user per work day. `arrivedAt` is the server clock.
/// `workDay` is that instant's calendar date in the member's covering
/// arrival-target timezone, or Asia/Singapore when they have none.
model WorkArrivalDay {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workDay    DateTime  @db.Date
  arrivedAt  DateTime?
  latitude   Decimal?  @db.Decimal(10, 7)
  longitude  Decimal?  @db.Decimal(10, 7)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@unique([userId, workDay])
  @@index([workDay(sort: Desc)])
}

model WorkArrivalTarget {
  id              String      @id @default(cuid())
  groupMemberId   String
  groupMember     GroupMember @relation(fields: [groupMemberId], references: [id], onDelete: Cascade)
  /// Calendar date this arrival target starts on.
  effectiveFrom   DateTime    @db.Date
  /// IANA timezone the clock time and work-day midnight are local to.
  timezone        String
  /// Minutes from local midnight, 0–1439.
  arrivalMinutes  Int
  /// JSON object keyed by JS weekday 0–6 (Sun=0). True means that weekday counts.
  days            Json
  latitude        Decimal     @db.Decimal(10, 7)
  longitude       Decimal     @db.Decimal(10, 7)
  radiusMeters    Int
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@unique([groupMemberId, effectiveFrom])
}

model WorkArrivalOverride {
  id             String      @id @default(cuid())
  groupMemberId  String
  groupMember    GroupMember @relation(fields: [groupMemberId], references: [id], onDelete: Cascade)
  /// Work-day calendar date this one-off arrival time applies to.
  date           DateTime    @db.Date
  timezone       String
  /// Minutes from local midnight, 0–1439.
  arrivalMinutes Int
  note           String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  @@unique([groupMemberId, date])
}

model WorkArrivalPenalty {
  id             String      @id @default(cuid())
  groupMemberId  String
  groupMember    GroupMember @relation(fields: [groupMemberId], references: [id], onDelete: Cascade)
  /// Calendar date this penalty rate starts on.
  effectiveFrom  DateTime    @db.Date
  /// Charge per lateness block.
  amount         Decimal     @db.Decimal(10, 2)
  unit           PenaltyUnit
  /// Required when unit is OTHER; ignored otherwise.
  unitLabel      String?
  /// Minutes in one lateness block. Partial blocks round up.
  blockMinutes   Int         @default(10)
  /// Most one counted work day can owe, in the same unit as amount.
  cap            Decimal     @db.Decimal(10, 2)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  @@unique([groupMemberId, effectiveFrom])
}

model GroupInvite {
  id          String       @id @default(cuid())
  groupId     String
  senderId    String
  recipientId String
  status      InviteStatus @default(PENDING)
  createdAt   DateTime     @default(now())
  respondedAt DateTime?

  group     Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  sender    User  @relation("InviteSender", fields: [senderId], references: [id], onDelete: Cascade)
  recipient User  @relation("InviteRecipient", fields: [recipientId], references: [id], onDelete: Cascade)

  @@unique([groupId, recipientId])
  @@index([recipientId, status])
}
